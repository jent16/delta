# Copy to .env and fill in. Never commit the real .env (already gitignored).

# Free developer account at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# API key (separate from a Claude Code session) from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional model overrides. Both default to Haiku 4.5 for cost.
#   INGEST_MODEL — bulk posting extraction (once per posting, at ingest)
#   RESUME_MODEL — resume extraction + fit explanation (twice per upload);
#                  defaults to INGEST_MODEL if unset
# INGEST_MODEL=claude-haiku-4-5-20251001
# RESUME_MODEL=claude-sonnet-5

# Notion tracker (optional): create an internal integration at
# https://www.notion.so/my-integrations, copy its token here, then share each
# tracker database with it (database ••• menu -> Connections).
NOTION_TOKEN=
