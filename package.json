{
  "name": "delta",
  "version": "1.0.0",
  "description": "A skill-gap analyzer built on real job postings: stores what each posting asks for, rolls it up per role and specialization, and scores a resume against it.",
  "main": "index.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"src/**/*.test.ts\"",
    "start": "node server.js",
    "ingest": "node scripts/ingest-role.js",
    "mock": "node scripts/mock-api.js",
    "dev": "node server.js --mock",
    "typecheck": "tsc --noEmit",
    "tracker": "node src/main.ts",
    "import:notion": "node --env-file-if-exists=.env src/import-notion.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jent16/delta.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jent16/delta/issues"
  },
  "homepage": "https://github.com/jent16/delta#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
